# webapp_site/ is the generated static deploy bundle (~286 MB). It is IGNORED by
# default so it doesn't bloat this research repo. For a git-based Vercel deploy
# you must commit it (or, cleaner, use a dedicated deploy repo) — see the deploy
# notes. To include it in THIS repo, delete the next line.
webapp_site/


# Node deps for the release-notes generator. `marked` is installed on demand
# (locally and in CI with --no-save), never vendored: landing/ is deployed
# as-is, so node_modules must not end up in the repo.
node_modules/
package-lock.json
